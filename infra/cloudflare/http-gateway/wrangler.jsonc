  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "containers": [
    {
      "class_name": "HttpGateway",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
