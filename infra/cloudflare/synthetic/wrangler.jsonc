{
  "name": "stonegate-synthetic-validation",
  "main": "worker.ts",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "SyntheticApi",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:166fd25e0265999880e3493dfb5a00312e9a7fd949c25157f476c4184599ecbb"
        }
      }
    },
    {
      "class_name": "SyntheticOutbox",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-outbox@sha256:ab8248f23ee0004059f77de66b88958e5b03d86153f4f002c90833d85bb2cbb4"
        }
      }
    },
    {
      "class_name": "SyntheticSite",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-site-private@sha256:294a427e1a4daa248110f8415f4b555644a68ffd368a9faf4f8e5dfc7029485b"
        }
      }
    }
  ],
  "durable_objects": {
    "code_update_strategy": {
      "mode": "immediate"
    },
    "bindings": [
      {
        "name": "API",
        "class_name": "SyntheticApi"
      },
      {
        "name": "OUTBOX",
        "class_name": "SyntheticOutbox"
      },
      {
        "name": "SITE",
        "class_name": "SyntheticSite"
      }
    ]
  },
  "exports": {
    "SyntheticApi": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "SyntheticOutbox": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "SyntheticSite": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
