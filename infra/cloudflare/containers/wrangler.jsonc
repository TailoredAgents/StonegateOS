{
  "name": "stonegate-container-validation",
  "main": "worker.ts",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "SiteValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-site@sha256:3fa92ad662b72c5b5441fe5b4c0e744251d9aca2ba89876c6f4879a5843f3077"
        }
      }
    },
    {
      "class_name": "ApiValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:657b7af5a48d1107140ef387d2a53226964d02ee5ab590ecbee3289539760e52"
        }
      }
    },
    {
      "class_name": "OutboxValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-outbox@sha256:f81ddef39b455ca91d922dc7738862deb02457a13eaebaf1e66fcabcaa3251ed"
        }
      }
    },
    {
      "class_name": "DiscordValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-discord@sha256:b4858c31fbf9ae5a90b7239e3477df71473891be1c03d6051bbf0165ba9b9d70"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE",
        "class_name": "SiteValidation"
      },
      {
        "name": "API",
        "class_name": "ApiValidation"
      },
      {
        "name": "OUTBOX",
        "class_name": "OutboxValidation"
      },
      {
        "name": "DISCORD",
        "class_name": "DiscordValidation"
      }
    ]
  },
  "exports": {
    "SiteValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ApiValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "OutboxValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DiscordValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
