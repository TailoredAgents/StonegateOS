      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-site@sha256:ade28c53adef0f5e4601a4351ef6d6422cded0e3e522519c3dd50c9a107973ab"
        }
      }
    },
    {
      "class_name": "ApiValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:66d89910bbb1e1dc6da83f468adccab2547a10f6866f216261cc3dd4c3e44524"
        }
      }
    },
    {
      "class_name": "OutboxValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-outbox@sha256:aa9c9c15d43cd5434ca735cb558545444d919980728478920fb59e476a7b6a4e"
        }
      }
    },
    {
      "class_name": "DiscordValidation",
