      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-site@sha256:8ff06b6346cd990b98f5d463963632ca3055f43f0b0c43a77b3f02a222b87106"
        }
      }
    },
    {
      "class_name": "ApiValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:91801d8098d93f5d9772b459c2289d8ae0afb232106f4b1109c5e66588dd7e8d"
        }
      }
    },
    {
      "class_name": "OutboxValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-outbox@sha256:9d597a5167948fa5d201ea4108b6e0f7e0639bf596266d2bf3b6cd2a0aeb2089"
        }
      }
    },
    {
      "class_name": "DiscordValidation",
