{
  "name": "stonegate-container-validation",
  "main": "worker.ts",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "SiteValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-site-private@sha256:294a427e1a4daa248110f8415f4b555644a68ffd368a9faf4f8e5dfc7029485b"
        }
      }
    },
    {
      "class_name": "ApiValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:ecb8e167bf43787288cceba6d403e4919f0ce27fe7415e622de07f0e359fcd07"
        }
      }
    },
    {
      "class_name": "OutboxValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-outbox@sha256:ab8248f23ee0004059f77de66b88958e5b03d86153f4f002c90833d85bb2cbb4"
        }
      }
    },
    {
      "class_name": "DiscordValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-discord@sha256:2a0416b40f2725efedac2b678c156191f8ddf7757edfc2006ffb57dec0b30458"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE",
        "class_name": "SiteValidation"
      },
      {
        "name": "API",
        "class_name": "ApiValidation"
      },
      {
        "name": "OUTBOX",
        "class_name": "OutboxValidation"
      },
      {
        "name": "DISCORD",
        "class_name": "DiscordValidation"
      }
    ]
  },
  "exports": {
    "SiteValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ApiValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "OutboxValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DiscordValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
