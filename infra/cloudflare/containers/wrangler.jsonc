        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-discord@sha256:2ae155b09f0d027214e9d5dfeaee3603780a206cc36c7faf8d088ce73aff59c2"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE",
        "class_name": "SiteValidation"
      },
      {
        "name": "API",
        "class_name": "ApiValidation"
      },
      {
        "name": "OUTBOX",
        "class_name": "OutboxValidation"
      },
      {
        "name": "DISCORD",
        "class_name": "DiscordValidation"
      }
