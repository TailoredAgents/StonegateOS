        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-discord@sha256:7bc9ace21cce857c338426d30bd40012cc65eae414dbcacac2462b79a581c202"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE",
        "class_name": "SiteValidation"
      },
      {
        "name": "API",
        "class_name": "ApiValidation"
      },
      {
        "name": "OUTBOX",
        "class_name": "OutboxValidation"
      },
      {
        "name": "DISCORD",
        "class_name": "DiscordValidation"
      }
