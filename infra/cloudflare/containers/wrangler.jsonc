{
  "name": "stonegate-container-validation",
  "main": "worker.ts",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "SiteValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-site@sha256:d71c61c28c261dbbd2a6b8faad3ccca28a987208df1bae0d8077872acd1d8d5d"
        }
      }
    },
    {
      "class_name": "ApiValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:ac6edd60e7b3ccd000625981aa4f4e9edf3b99879a1388587a32874ac0fc5869"
        }
      }
    },
    {
      "class_name": "OutboxValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-outbox@sha256:53f2986b484ce1fd96d085801f208937149b6e0f56206312ac114219a7501257"
        }
      }
    },
    {
      "class_name": "DiscordValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-discord@sha256:1e6fc86c27777d50eb06638684d698a743d5dcd5a3b102f569a2a256bb9b0595"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE",
        "class_name": "SiteValidation"
      },
      {
        "name": "API",
        "class_name": "ApiValidation"
      },
      {
        "name": "OUTBOX",
        "class_name": "OutboxValidation"
      },
      {
        "name": "DISCORD",
        "class_name": "DiscordValidation"
      }
    ]
  },
  "exports": {
    "SiteValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ApiValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "OutboxValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DiscordValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
