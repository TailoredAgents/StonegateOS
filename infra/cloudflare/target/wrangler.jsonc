{
  "name": "stonegate-target-readiness",
  "main": "worker.ts",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "TargetReadinessValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:166fd25e0265999880e3493dfb5a00312e9a7fd949c25157f476c4184599ecbb"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TARGET_DATABASE",
        "class_name": "TargetReadinessValidation"
      }
    ],
    "code_update_strategy": {
      "mode": "immediate"
    }
  },
  "exports": {
    "TargetReadinessValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
