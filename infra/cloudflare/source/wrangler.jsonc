{
  "name": "stonegate-source-readiness",
  "main": "worker.ts",
  "account_id": "78ed83c6e3947c93763acef3a48a5561",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "SourceReadinessValidation",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/78ed83c6e3947c93763acef3a48a5561/stonegate-migration-api@sha256:ac6edd60e7b3ccd000625981aa4f4e9edf3b99879a1388587a32874ac0fc5869"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SOURCE_DATABASE",
        "class_name": "SourceReadinessValidation"
      }
    ],
    "code_update_strategy": {
      "mode": "immediate"
    }
  },
  "exports": {
    "SourceReadinessValidation": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
