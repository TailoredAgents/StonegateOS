# Appointment media (private LocalStack S3)
APPOINTMENT_MEDIA_WRITES_ENABLED=1
PUBLIC_QUOTE_MEDIA_UPLOADS_ENABLED=1
MEDIA_AUTO_IMPORT_ENABLED=1
MOBILE_OFFLINE_MEDIA_ENABLED=1
MEDIA_OBJECT_ENDPOINT=http://localhost:4566
MEDIA_OBJECT_REGION=us-east-1
MEDIA_OBJECT_BUCKET=stonegate-appointment-media-e2e
MEDIA_OBJECT_ACCESS_KEY_ID=test
MEDIA_OBJECT_SECRET_ACCESS_KEY=test
MEDIA_OBJECT_FORCE_PATH_STYLE=1
MEDIA_OBJECT_AUTO_CREATE_BUCKET=1
APPOINTMENT_MEDIA_CLEANUP_INTERVAL_MS=3600000

# Automated E2E may read only from the deterministic loopback Square fake and
# must never launch the real POS application.
SQUARE_POS_ENABLED=0
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=e2e-square-access-token
SQUARE_LOCATION_ID=location-e2e-0001
SQUARE_API_BASE_URL=http://127.0.0.1:4015
SQUARE_FAKE_CONTROL_URL=http://127.0.0.1:4015

# Outbox Worker defaults
OUTBOX_BATCH_SIZE=5
OUTBOX_POLL_INTERVAL_MS=500
