# General
NODE_ENV=
APPOINTMENT_TIMEZONE=America/New_York # optional; defaults to Eastern (America/New_York) if unset
E2E_RUN_ID=

# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_API_BASE_URL=
# Public site branding (build-time; keep the marketing site fast and cacheable)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_PHONE_E164=
NEXT_PUBLIC_COMPANY_PHONE_DISPLAY=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_LOGO_PATH=
NEXT_PUBLIC_COMPANY_SERVICE_AREA=
NEXT_PUBLIC_COMPANY_HOURS_SUMMARY=
NEXT_PUBLIC_COMPANY_HQ_CITY=
NEXT_PUBLIC_COMPANY_HQ_STATE=
NEXT_PUBLIC_COMPANY_HQ_COUNTRY=US
NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=
NEXT_PUBLIC_FACEBOOK_PAGE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# API Access
API_BASE_URL=http://localhost:3001
ADMIN_API_KEY=
# Quote public abuse controls. Set the same two secrets on the Site and API;
# neither is exposed through NEXT_PUBLIC_* variables. The site sends only a
# signed HMAC /24 or /64 class to the API. Render has one trusted proxy hop, so
# select the right-most X-Forwarded-For entry rather than trusting the first.
QUOTE_RATE_LIMIT_HMAC_SECRET=
QUOTE_PUBLIC_PROXY_SHARED_SECRET=
QUOTE_PUBLIC_TRUSTED_PROXY_HOPS=1
# Quote send payloads retain provider retry data only as AES-256-GCM
# ciphertext. JSON maps key IDs to 32-byte base64 keys; keep retired keys until
# every delivery encrypted with them has passed retention. The address HMAC key
# must be an independent 32-byte base64 key.
QUOTE_DELIVERY_ENCRYPTION_KEY_ID=primary
QUOTE_DELIVERY_ENCRYPTION_KEYS_JSON=
QUOTE_DELIVERY_ADDRESS_HMAC_KEY_BASE64=
# Browser-only secret for the transitional `/admin` shell and legacy owner
# recovery cookie. It must be independent from ADMIN_API_KEY, random, and at
# least 32 bytes in production so a browser cookie can never authenticate as
# an internal service.
ADMIN_SESSION_SECRET=
# Used to HMAC team-login rate-limit keys so email addresses, phone numbers,
# and client IPs are never stored in the rate-limit table. Must contain at least
# 32 bytes in production. It may fall back to a 32-byte ADMIN_API_KEY during
# rollout, but a separate secret is preferred.
TEAM_AUTH_RATE_LIMIT_SECRET=
# E2E-only bypass. The API honors this value only when NODE_ENV=test or
# E2E_RUN_ID is set and the request sends it in x-team-auth-rate-limit-bypass.
TEAM_AUTH_RATE_LIMIT_BYPASS_TOKEN=
# Temporary break-glass migration. ADMIN_SESSION_SECRET and
# CREW_SESSION_SECRET are required by the Site to validate old recovery
# cookies; neither has a built-in/default value.
# The API maps a successful exchange only to these explicit active member IDs:
# owner must effectively have access.manage; crew must have appointments.read.
# Break-glass sessions expire after one hour and are independently revocable.
CREW_SESSION_SECRET=
TEAM_BREAK_GLASS_OWNER_MEMBER_ID=
TEAM_BREAK_GLASS_CREW_MEMBER_ID=
# Operational requirement: after staff have migrated, independently rotate
# ADMIN_API_KEY, ADMIN_SESSION_SECRET, and CREW_SESSION_SECRET in external
# secret stores, then remove legacy login surfaces. Never restore legacy-cookie
# authorization as a rollback mechanism.
SOLD_BY_OVERRIDE_CODE=
CORS_ALLOW_ORIGINS=

# Analytics (server-side)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Database
DATABASE_URL=

# OpenAI (Chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_INBOX_SUGGEST_MODEL=
# Optional receipt-specific override; falls back to OPENAI_MODEL.
OPENAI_EXPENSE_MODEL=
# Receipt worker request deadline (5,000-120,000 ms).
OPENAI_EXPENSE_TIMEOUT_MS=60000
# Optional provider base. Defaults to https://api.openai.com/v1 in normal
# environments. E2E and Team CRM audit runs fail closed unless this is a
# loopback URL, for example http://127.0.0.1:4011/v1.
OPENAI_API_BASE_URL=
# Nonproduction control plane for the Docker OpenAI fake. It never receives
# production traffic and retains only bounded, redacted request metadata.
OPENAI_FAKE_CONTROL_URL=
# Optional explicit audit safety mode. In nonproduction, this or E2E_RUN_ID
# forces controlled providers to loopback. A production-build E2E run requires
# both a nonempty E2E_RUN_ID and the exact TEAM_CRM_AUDIT_MODE=1 sentinel; one
# flag alone can never enable loopback providers in production.
TEAM_CRM_AUDIT_MODE=0
# Team/Discord agent tuning (optional)
OPENAI_TEAM_MODEL=
OPENAI_TEAM_REASONING_EFFORT=medium

# Agent bot (machine-to-machine auth for agent APIs)
# Used by Discord “Jarvis” and any future integrations.
AGENT_BOT_SHARED_SECRET=

# Google Ads / Analytics
# Google Ads tag ID (e.g. AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=
# Lead/quote conversion "send_to" string (e.g. AW-123456789/AbCdEfGhIjK)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=
# Phone click conversion "send_to" string (e.g. AW-123456789/AbCdEfGhIjK)
NEXT_PUBLIC_GOOGLE_ADS_CALL_SEND_TO=
# Conversion "send_to" string (e.g. AW-123456789/AbCdEfGhIjK)
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_SEND_TO=

# Instant Quote / Booking
# Promo discount applied to instant quote price ranges (e.g. 0.15 = 15% off).
INSTANT_QUOTE_DISCOUNT=0.15
# Max number of simultaneous appointments allowed (1 = no double-booking, 2 = two trailers, etc.)
APPOINTMENT_CAPACITY=

# Appointment media and mobile rollout switches (API-enforced; keep disabled until rollout)
APPOINTMENT_MEDIA_WRITES_ENABLED=0
PUBLIC_QUOTE_MEDIA_UPLOADS_ENABLED=0
MEDIA_AUTO_IMPORT_ENABLED=0
MOBILE_OFFLINE_MEDIA_ENABLED=0
# Expense receipt capture remains off until the production pilot is verified.
EXPENSE_RECEIPT_CAPTURE_ENABLED=0
# Must be enabled on both API and outbox worker; API capability stays off when
# either side is disabled so uploads can never be stranded without analysis.
EXPENSE_RECEIPT_WORKER_ENABLED=0
# Keep this off for the 30-50 receipt owner pilot. Enable only after that gate.
EXPENSE_RECEIPT_CREW_ENABLED=0
# Independent expense rollout switches; enable only after their verification gate.
EXPENSE_AD_SPEND_ENABLED=0
EXPENSE_REIMBURSEMENT_ENABLED=0
EXPENSE_OVERVIEW_ENABLED=0
# Gates new dump-ticket review, weight mutations, and History filter. Stored
# dump facts remain readable when disabled.
EXPENSE_DUMP_TICKETS_ENABLED=0
# Gates owner fixed-cost setup and edits. Stored costs remain in Overview when off.
EXPENSE_FIXED_COSTS_ENABLED=0
SQUARE_POS_ENABLED=0

# `/team` migration/canary safety switches. Set to 1/true/on to block the
# corresponding server-side operation even for otherwise authorized users.
TEAM_KILL_EXTERNAL_SENDS=0
TEAM_KILL_FINANCIAL_MUTATIONS=0
TEAM_KILL_DESTRUCTIVE_MUTATIONS=0
TEAM_KILL_ADVERTISING_CHANGES=0
TEAM_KILL_PUBLISHING=0
TEAM_KILL_OUTBOX_DISPATCH=0

# Private S3-compatible appointment media storage
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# LocalStack: http://localhost:4566
MEDIA_OBJECT_ENDPOINT=
MEDIA_OBJECT_REGION=auto
MEDIA_OBJECT_BUCKET=stonegate-appointment-media
MEDIA_OBJECT_ACCESS_KEY_ID=
MEDIA_OBJECT_SECRET_ACCESS_KEY=
MEDIA_OBJECT_FORCE_PATH_STYLE=1
# Development/LocalStack only. A production-build E2E artifact may enable this
# only with both controlled audit sentinels; ordinary production rejects it.
MEDIA_OBJECT_AUTO_CREATE_BUCKET=0
APPOINTMENT_MEDIA_CLEANUP_INTERVAL_MS=3600000

# Square POS app handoff (one fixed US seller location)
SQUARE_ENVIRONMENT=production
# Provider override is for the deterministic local/CI fake. Production normally
# uses the official Square origin and rejects loopback overrides.
SQUARE_API_BASE_URL=
SQUARE_FAKE_CONTROL_URL=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_POS_CALLBACK_URL=
SQUARE_POS_FALLBACK_URL=
# At least 32 bytes; generate a random base64url secret.
SQUARE_POS_STATE_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_RECONCILIATION_INTERVAL_MS=120000

# Stripe
STRIPE_SECRET_KEY=

# Google Calendar
GOOGLE_CALENDAR_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_CALENDAR_SYNC_LOOKBACK_DAYS=45
# Provider overrides are for deterministic local/CI fakes. Production normally
# uses the secure Google defaults and rejects loopback overrides.
GOOGLE_CALENDAR_API_BASE_URL=
GOOGLE_CALENDAR_TOKEN_URL=
GOOGLE_CALENDAR_FAKE_CONTROL_URL=

# Google Ads API (reporting)
# Create these in Google Cloud + Google Ads API center, then generate a refresh token with the googleads scope.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Google Ads customer ID (no dashes preferred).
GOOGLE_ADS_CUSTOMER_ID=
# Optional: manager account customer ID (MCC) if your developer token requires it.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: API version (current default v25 as of August 2026).
# Google Ads API releases deprecate older versions regularly; review the
# official sunset timetable before changing this value.
GOOGLE_ADS_API_VERSION=v25
# Provider overrides are for deterministic local/CI fakes. Production uses the
# official Google HTTPS endpoints and rejects loopback overrides.
GOOGLE_ADS_API_BASE_URL=
GOOGLE_ADS_TOKEN_URL=
GOOGLE_ADS_FAKE_CONTROL_URL=
# Optional: how often the outbox worker auto-queues a sync (ms). Default is 24h.
GOOGLE_ADS_SYNC_INTERVAL_MS=
# Optional: set to 1 to disable auto-sync.
GOOGLE_ADS_SYNC_DISABLED=

# Facebook/Messenger Webhook
# Provider overrides are for deterministic local/CI fakes. Production normally
# uses https://graph.facebook.com and rejects loopback overrides.
FACEBOOK_GRAPH_API_BASE_URL=
# Nonproduction control plane for deterministic Meta scenarios and bounded,
# privacy-safe evidence. It must share the Graph provider origin.
META_FAKE_CONTROL_URL=
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_LEADGEN_ACCESS_TOKEN=
FB_MESSENGER_ACCESS_TOKEN=
FB_LEAD_FORM_IDS=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
META_DATASET_ID=
META_CONVERSIONS_TOKEN=
META_LEAD_EVENT_SOURCE=StonegateOS
FB_AD_ACCOUNT_ID=
FB_MARKETING_ACCESS_TOKEN=

# Notifications (SMS/Email)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Required exact public API origin used in the Twilio Console for webhook URLs.
# Production requires HTTPS and never derives this value from request headers.
TWILIO_WEBHOOK_PUBLIC_BASE_URL=
# Optional provider base. Team E2E/audit runs require the loopback Twilio fake;
# normal production defaults to the public Twilio API when this is blank.
TWILIO_API_BASE_URL=
# Nonproduction control plane for deterministic Twilio scenarios and bounded,
# privacy-safe request evidence. It must share TWILIO_API_BASE_URL's origin.
TWILIO_FAKE_CONTROL_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional bounded SMTP transport timeout (100-30000 ms; default 10000).
SMTP_TIMEOUT_MS=
# Optional explicit TLS mode. Port 465 enables it automatically; non-loopback
# STARTTLS transports require TLS even when this is blank.
SMTP_SECURE=
# Nonproduction deterministic email control plane. It retains metadata only.
EMAIL_FAKE_CONTROL_URL=
# The fake may relay accepted E2E messages only to the exact local MailHog
# target (`mailhog:1025` in Compose); arbitrary relay egress is rejected.
EMAIL_FAKE_FORWARD_SMTP_HOST=
EMAIL_FAKE_FORWARD_SMTP_PORT=

# Direct Message (DM) webhook
DM_WEBHOOK_URL=
DM_WEBHOOK_TOKEN=
DM_WEBHOOK_FROM=

# Internal Alerts
QUOTE_ALERT_EMAIL=
LEAD_ALERT_SMS=
SPEED_TO_LEAD_SLA_SMS_ENABLED=0

# Outbox Worker
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=0
OUTBOX_HEARTBEAT_INTERVAL_MS=30000
SEO_AUTOPUBLISH_INTERVAL_MS=
SEO_AUTOPUBLISH_DISABLED=

# Discord Agent (optional worker)
DISCORD_BOT_TOKEN=
DISCORD_AGENT_SITE_URL=
# Allow one or more guilds (comma-separated). If unset, the bot allows any guild it is in.
DISCORD_GUILD_ID=
DISCORD_GUILD_IDS=
# Optional: restrict approvals to specific role IDs (comma-separated). If unset, any guild member can approve.
DISCORD_APPROVER_ROLE_IDS=
DISCORD_COMMAND_PREFIX=!sg
DISCORD_REQUIRE_MENTION=true
DISCORD_INTENT_TTL_MIN=30
DISCORD_WAKE_WORDS=jarvis,stonegate assist,stonegate
# If true, the bot responds to every message in allowed guild(s) (dangerous/noisy).
DISCORD_RESPOND_ALL=false
# If true, the bot ignores server channels and works only in Discord DMs.
DISCORD_DM_ONLY=false
# How many recent Discord messages to include as context (DMs + channels).
DISCORD_CONTEXT_MESSAGE_LIMIT=20
# Scheduled reports (Stage 2)
DISCORD_REPORTS_ENABLED=true
DISCORD_REPORT_TIMEZONE=America/New_York
DISCORD_DAILY_REPORT_AT=08:30
DISCORD_REPORT_CHECK_MS=30000

# Agent memory (Stage 3)
DISCORD_MEMORY_ENABLED=true
DISCORD_MEMORY_MAX_ITEMS=12

# Ops monitor alerts + diagnostics (Stage 4/5)
DISCORD_MONITOR_ENABLED=true
DISCORD_MONITOR_CHECK_MS=120000
DISCORD_MONITOR_COOLDOWN_MIN=30
# If enabled, critical alerts include an approval-gated "ops_diagnose" snapshot option.
DISCORD_MONITOR_DIAGNOSTICS_ENABLED=true
